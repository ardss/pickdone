#!/bin/sh
# pre-commit 门禁 —— 任何一项失败则拒绝提交
# 安装：git config core.hooksPath .githooks （仓库初始化时执行一次，见 npm run setup:hooks）
# 策略：check-tokens 全量秒级；其余只查「本次提交涉及的文件」，保证秒级完成，不阻塞小改动
# CWD 归一：git 从仓库根调用钩子，而门禁命令（eslint/单测）的路径都按 pickdone 写
cd "$(git rev-parse --show-toplevel)/pickdone" || { echo "  ✗ 找不到 pickdone 目录"; exit 1; }

echo "[pre-commit] 1/4 语法校验（node --check 变更的 .js）"
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.m?js$'); do
  if [ -f "$f" ]; then
    node --check "$f" 2>/tmp/hook-check.err || { echo "  ✗ 语法错误: $f"; cat /tmp/hook-check.err; fail=1; }
  fi
done
[ $fail -eq 1 ] && exit 1
echo "  ✓ 通过"

echo "[pre-commit] 2/4 token 纪律（写死浅色背景=深色白块元凶）"
node cli/check-tokens.js || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 2.5/4 ESM 模块图（import/export 匹配——白屏级事故在提交时拦截）"
node cli/check-esm-graph.cjs || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 3/4 ESLint（0 error 才放行，warning 不阻塞）"
npx eslint renderer/js cli src tests --quiet || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 4/4 单元测试（全量 11 文件——只跑单文件会放过 store/utils 等核心回归）"
npm test --silent 2>&1 | grep -qE "# fail 0" # 匹配 TAP 摘要；若换 --test-reporter spec 该行会恒失败(假红) || { echo "  ✗ 单测失败（npm test 查看详情）"; exit 1; }
echo "  ✓ 通过"

echo "[pre-commit] 全部通过 ✓"
