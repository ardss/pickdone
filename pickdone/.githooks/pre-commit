#!/bin/sh
# pre-commit 门禁 —— 任何一项失败则拒绝提交
# 安装：git config core.hooksPath .githooks （仓库初始化时执行一次，见 npm run setup:hooks）
# 策略：check-tokens 全量秒级；其余只查「本次提交涉及的文件」，保证秒级完成，不阻塞小改动
# CWD 归一：git 从仓库根调用钩子，而门禁命令（eslint/单测）的路径都按 pickdone 写
cd "$(git rev-parse --show-toplevel)/pickdone" || { echo "  ✗ 找不到 pickdone 目录"; exit 1; }

echo "[pre-commit] 1/4 语法校验（node --check 变更的 .js/.mjs/.cjs）"
fail=0
# while-read 逐行处理而非 for 循环分词:for 会按空白切分,路径带空格的变更文件被静默跳过。
# 过滤器 .[cm]?js 覆盖 .js/.cjs/.mjs(旧 '\.m?js$' 漏 .cjs);tr -d '\r' 容忍 CRLF 名单行。
# 2026-10-26 堵假绿:git 打印的是仓库根相对路径(pickdone/...),而钩子已 cd 进 pickdone/,
# 旧的 [ -f "$f" ] 对每个文件都判"不存在",本阶段整个生命周期里实际检查了 0 个文件却一直绿。
# 剥掉 pickdone/ 前缀后再做存在性判断(与 cli/lint-staged.mjs / check-file-size.cjs 同款),
# 并在"有 staged js 却 0 个被检查"时拒绝放行。列表落盘再 while<file:管道子 shell 里改
# checked 计数传不出来,重定向方式让循环跑在当前 shell。
jslist=/tmp/hook-staged-js.$$
errfile=/tmp/hook-check.err.$$  # 带 $$ 后缀:并发钩子实例互相覆盖对方的错误文件(与上行 jslist 同款)
git diff --cached --name-only --diff-filter=ACM | tr -d '\r' | grep -E '\.[cm]?js$' > "$jslist" || true
checked=0
# 2026-10-27 堵漏检:pickdone/ 前缀剥掉后按 pickdone 相对路径检查;仓根其他目录的 JS
# (qa/**、analysis/**、test/** 等)原样加 ../ 前缀检查——旧逻辑只剥前缀,非 pickdone 路径
# 的 [ -f ] 判不存在被静默跳过(混合提交时外部 JS 漏检)。
while IFS= read -r f; do
  case "$f" in
    pickdone/*) rel="${f#pickdone/}" ;;
    *) rel="../$f" ;;
  esac
  [ -f "$rel" ] || continue
  if ! node --check "$rel" 2>"$errfile"; then
    echo "  ✗ 语法错误: $f"
    cat "$errfile"
    fail=1
    break
  fi
  checked=$((checked + 1))
done < "$jslist"
[ $fail -eq 1 ] && exit 1
# 熔断只对"确实存在 staged js"生效:列表为空(如纯文档提交)检查 0 个是正常绿;
# 列表非空却 0 个通过存在性判断 = 路径归一化失效,拒绝假绿(参照 check-file-size.cjs 2026-10-10 修复)。
# 判断必须发生在 rm 之前。
jslist_nonempty=0; [ -s "$jslist" ] && jslist_nonempty=1
rm -f "$jslist"
if [ "$jslist_nonempty" -eq 1 ] && [ "$checked" -eq 0 ]; then
  echo "  ✗ 有 staged 的 js/cjs/mjs 文件但 0 个通过了语法检查（路径归一化失效）——拒绝假绿（参照 check-file-size.cjs 2026-10-10 修复）"
  exit 1
fi
echo "  ✓ 通过（检查 $checked 个文件）"

echo "[pre-commit] 2/4 token 纪律（写死浅色背景=深色白块元凶）"
node cli/check-tokens.js || exit 1
node cli/check-css-freeze.mjs || exit 1
node cli/check-file-size.cjs --staged || exit 1
node cli/check-boot-order.cjs --staged || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 2.5/4 ESM 模块图（import/export 匹配——白屏级事故在提交时拦截）"
node cli/check-esm-graph.cjs || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 3/4 ESLint（0 error 才放行，warning 不阻塞；--cache 热跑秒级,与 check:all 共用 .eslintcache）"
node cli/lint-staged.mjs || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 4/4 单元测试（core 层=纯进程内规格;深潜层套件——真 Electron/双实例 lan-sync/loopback 演练——归 check:all 全量）"
# 2026-09-13 堵假绿:不再 `npm test | grep "# fail 0"`(管道吞 exit code + 任意来源字符串即假绿)。
# 改由 cli/check-test-summary.cjs 统一校验:exit code 非 0 即红 + TAP 摘要 fail=0 + skip 棘轮(≤基线,超线提示"新增 skip 需要说明+降基线")
# 2026-10-23 效率波:改跑 --core 层。深潜层套件慢(分钟级/个)且负载敏感(宿主高载时级联出
# 假红,2026-10-22 实锤 17 条 not ok 里 12 条属此类、隔离全绿),不该在每次提交时打全量;
# 合并门禁 check:all 仍跑全池兜底。
node cli/check-test-summary.cjs --core --affected --retry-once || exit 1
echo "  ✓ 通过"

echo "[pre-commit] 全部通过 ✓"
